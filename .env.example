# Copy to .env and replace every placeholder before real use.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# memory: trial mode, data disappears when the process stops.
# prisma: PostgreSQL persistence. Required in production.
STORAGE=memory
DATABASE_URL=postgresql://agentsecure:agentsecure@localhost:5432/agentsecure?schema=public

# Uncomment when Redis is running. Required in production.
# REDIS_URL=redis://localhost:6379

# Bootstrap key for creating tenants and the first API key. Shown to operators only.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Salt for IP hashes and detection fingerprints. Changing it makes old hashes uncomparable.
IP_HASH_SALT=replace-with-a-long-random-salt

# Set to true only for a local upstream that has no TLS.
ALLOW_INSECURE_UPSTREAM=false

# Internal proof lifetime in seconds. Maximum 300.
PROOF_TTL_SECONDS=300

# Optional. Receives a minimized JSON alert when a request is blocked.
# ALERT_WEBHOOK_URL=https://example.internal/hooks/agentsecure
