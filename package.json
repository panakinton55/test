{
  "name": "agentsecure-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Secure egress gateway that reduces data-leakage risk when AI agents call external LLMs and tools.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx src/openapi/writeSpec.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "schema": "src/db/schema.prisma"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/swagger-ui": "^0.5.1",
    "@prisma/client": "^6.6.0",
    "hono": "^4.7.7",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
